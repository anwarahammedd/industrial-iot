{
  "title": "Industrial IoT Monitoring",
  "uid": "industrial-iot",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",

  "time": {
    "from": "now-15m",
    "to": "now"
  },

  "panels": [
    {
      "id": 1,
      "title": "Temperature",
      "type": "timeseries",

      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },

      "datasource": {
        "type": "postgres",
        "uid": "efyypcjnkwe80c"
      },

      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT created_at AS \"time\", temperature FROM sensor_readings WHERE $__timeFilter(created_at) ORDER BY created_at;",
          "format": "time_series"
        }
      ],

      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },

      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },

    {
      "id": 2,
      "title": "Pressure",
      "type": "timeseries",

      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },

      "datasource": {
        "type": "postgres",
        "uid": "efyypcjnkwe80c"
      },

      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT created_at AS \"time\", pressure FROM sensor_readings WHERE $__timeFilter(created_at) ORDER BY created_at;",
          "format": "time_series"
        }
      ],

      "fieldConfig": {
        "defaults": {
          "unit": "pressurebar"
        },
        "overrides": []
      },

      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },

    {
      "id": 3,
      "title": "Flow",
      "type": "timeseries",

      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },

      "datasource": {
        "type": "postgres",
        "uid": "efyypcjnkwe80c"
      },

      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT created_at AS \"time\", flow FROM sensor_readings WHERE $__timeFilter(created_at) ORDER BY created_at;",
          "format": "time_series"
        }
      ],

      "fieldConfig": {
        "defaults": {
          "unit": "flowlpm"
        },
        "overrides": []
      },

      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },

    {
      "id": 4,
      "title": "Motor Status",
      "type": "timeseries",

      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },

      "datasource": {
        "type": "postgres",
        "uid": "efyypcjnkwe80c"
      },

      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT created_at AS \"time\", CASE WHEN motor_status = true THEN 1 ELSE 0 END AS motor_status FROM sensor_readings WHERE $__timeFilter(created_at) ORDER BY created_at;",
          "format": "time_series"
        }
      ],

      "fieldConfig": {
        "defaults": {
          "unit": "bool"
        },
        "overrides": []
      },

      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    }
  ]
}